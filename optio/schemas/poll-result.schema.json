{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlashq-gg/custos/optio/schemas/poll-result.schema.json",
  "title": "optio poll result (unstable)",
  "description": "The result of the tool poll_events of a producer (optio/docs/producers.md).",
  "type": "object",
  "required": ["events", "cursor", "truncated", "has_more"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "time", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
          "time": { "type": "string", "format": "date-time" },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cursor": { "type": "string", "minLength": 1 },
    "truncated": { "type": "boolean" },
    "has_more": { "type": "boolean" }
  }
}
