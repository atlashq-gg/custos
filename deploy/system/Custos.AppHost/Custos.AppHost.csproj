    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The full system: the server is a domain service behind Optio (ADR 0006). -->
    <ProjectReference Include="..\..\..\optio\Optio\Optio.csproj" />
    <ProjectReference Include="..\..\..\server\Custos.Server\Custos.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.6.5-preview.1.26559.7" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
  </ItemGroup>
</Project>
