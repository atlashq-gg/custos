{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlashq-gg/custos/spec/schemas/message.schema.json",
  "title": "Custos stream message (unstable)",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "kind": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "reference": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "state": { "$ref": "query-state.schema.json#/$defs/state" },
    "deadline": { "type": "string", "format": "date-time" },
    "cause": { "type": "string", "minLength": 1 }
  },
  "if": {
    "properties": { "kind": { "const": "query" } }
  },
  "then": {
    "required": ["reference", "state"],
    "properties": { "reference": { "$ref": "query.schema.json#/$defs/reference" } }
  },
  "else": {
    "properties": { "text": { "maxLength": 500 } }
  }
}
