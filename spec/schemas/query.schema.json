{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlashq-gg/custos/spec/schemas/query.schema.json",
  "title": "Custos query or answer to a confirmation (unstable)",
  "oneOf": [
    {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "not": { "required": ["confirm"] }
    },
    {
      "type": "object",
      "required": ["confirm", "accept"],
      "properties": {
        "confirm": { "type": "string", "minLength": 1 },
        "accept": { "type": "boolean" }
      },
      "not": { "required": ["text"] }
    }
  ]
}
