{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlashq-gg/custos/spec/schemas/query.schema.json",
  "title": "Custos query (unstable)",
  "type": "object",
  "required": ["reference", "text", "width", "lines"],
  "properties": {
    "reference": { "$ref": "#/$defs/reference" },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "width": { "type": "integer", "minimum": 20, "maximum": 200 },
    "lines": { "type": "integer", "minimum": 1, "maximum": 50 },
    "new_conversation": { "type": "boolean" }
  },
  "not": { "required": ["action"] },
  "$defs": {
    "reference": { "type": "string", "pattern": "^[A-Za-z0-9-]{8,64}$" }
  }
}
