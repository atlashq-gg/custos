{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlashq-gg/custos/spec/schemas/discovery.schema.json",
  "title": "Custos discovery document",
  "type": "object",
  "required": [
    "custos_versions_supported",
    "service_name",
    "upload_endpoint",
    "upload_max_bytes",
    "upload_min_interval_seconds",
    "openid_configuration",
    "client_id",
    "scopes"
  ],
  "properties": {
    "custos_versions_supported": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9]+$" }
    },
    "service_name": { "type": "string", "minLength": 1 },
    "service_documentation": { "type": "string", "format": "uri" },
    "upload_endpoint": { "type": "string", "format": "uri" },
    "upload_max_bytes": { "type": "integer", "minimum": 1 },
    "upload_min_interval_seconds": { "type": "integer", "minimum": 0 },
    "openid_configuration": { "type": "string", "format": "uri" },
    "client_id": { "type": "string", "minLength": 1 },
    "scopes": { "type": "array", "items": { "type": "string" } },
    "stream_endpoint": { "type": "string", "format": "uri" },
    "query_endpoint": { "type": "string", "format": "uri" }
  }
}
