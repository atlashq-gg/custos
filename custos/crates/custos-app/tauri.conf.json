{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Custos",
  "mainBinaryName": "custos",
  "identifier": "gg.atlashq.custos",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Sends Foxhole stockpile data to a Custos service.",
    "copyright": "The Custos contributors",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["custos"]
      }
    }
  }
}
