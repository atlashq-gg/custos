<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Custos.Server\Custos.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests validate the server against the files of spec/, the authority for the contract. -->
    <None
      Include="..\..\spec\schemas\*.json"
      LinkBase="spec"
      CopyToOutputDirectory="PreserveNewest"
    />
    <!-- The producer contract of the events, and the NATS configuration of development. -->
    <None
      Include="..\..\optio\schemas\*.json"
      LinkBase="optio"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="..\..\optio\nats\nats.conf"
      Link="nats\nats.conf"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None Include="Discord\CommandGuards.txt" CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="Catalog\test-catalog.json"
      Link="TestData\test-catalog.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None Include="Mcp\McpTools.txt" CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="..\keycloak\custos-realm.json"
      Link="keycloak\custos-realm.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Testcontainers" Version="4.17.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
  </ItemGroup>
</Project>
