<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Custos.Server</AssemblyName>
    <RootNamespace>Custos.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.21.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Custos.Server.Tests" />
  </ItemGroup>

</Project>
