<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Custos.Server</AssemblyName>
    <RootNamespace>Custos.Server</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- The Aspire integration references an older EF Core 10. This reference sets the version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="NetCord" Version="1.0.0-beta.30" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.30" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.30" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.30" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageReference Include="NATS.Client.JetStream" Version="3.4.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.21.0" />
  </ItemGroup>

  <!-- The catalog of the game is a separate file with its own license (catalog/LICENSE.md). The
       license files go with it. -->
  <ItemGroup>
    <None
      Include="..\catalog\catalog.json;..\catalog\LICENSE.md;..\catalog\CC-BY-NC-SA-4.0.txt"
      Link="catalog\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      Condition="Exists('..\catalog\catalog.json')"
    />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Custos.Server.Tests" />
  </ItemGroup>
</Project>
