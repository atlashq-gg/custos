{
  "realm": "custos",
  "enabled": true,
  "displayName": "Custos (development)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "clientPolicies": {
    "policies": [
      {
        "name": "custos-cimd",
        "description": "Clients whose ID is the URL of a Client ID Metadata Document on the Custos server.",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-scheme": ["http", "https"],
              "client-id-uri-allow-permitted-domains": ["${CUSTOS_CIMD_HOST}", "claude.ai"]
            }
          }
        ],
        "profiles": ["custos-cimd"]
      },
      {
        "name": "custos-pkce",
        "description": "Each client uses PKCE with S256, also a client that a harness registers.",
        "enabled": true,
        "conditions": [
          {
            "condition": "any-client",
            "configuration": {}
          }
        ],
        "profiles": ["custos-pkce"]
      }
    ]
  },
  "clientProfiles": {
    "profiles": [
      {
        "name": "custos-cimd",
        "description": "Accepts the metadata document of Custos. HTTP is for development only. The host of a private-use redirect URI such as custos://oauth2callback is its first segment, so it is a permitted domain.",
        "executors": [
          {
            "executor": "client-id-metadata-document",
            "configuration": {
              "cimd-allow-http-scheme": "true",
              "cimd-allow-permitted-domains": [
                "${CUSTOS_CIMD_HOST}",
                "oauth2callback",
                "claude.ai",
                "localhost",
                "127.0.0.1"
              ],
              "cimd-resource-indicator-allow-list": ["${CUSTOS_MCP_RESOURCE}"]
            }
          }
        ]
      },
      {
        "name": "custos-pkce",
        "description": "PKCE with S256 for each client.",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": { "auto-configure": "true" }
          }
        ]
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for add all basic claims to the token",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "introspection.token.claim": "true", "access.token.claim": "true" }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "custos-discord",
      "description": "The Discord user ID of the user in the claim discord_id.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "discord_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "discord_id",
            "claim.name": "discord_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "custos:read",
      "description": "Read the guild records through the MCP endpoint of Custos.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your guild records in Custos"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${CUSTOS_MCP_RESOURCE}",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "discord_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "discord_id",
            "claim.name": "discord_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "custos:write",
      "description": "Change structure labels through the MCP endpoint of Custos.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Change structure labels in Custos"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${CUSTOS_MCP_RESOURCE}",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "discord_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "discord_id",
            "claim.name": "discord_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "custos-discord"],
  "defaultOptionalClientScopes": ["custos:read", "custos:write"],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"discord_id\",\"displayName\":\"Discord user ID\",\"validations\":{\"pattern\":{\"pattern\":\"^[0-9]{17,20}$\",\"error-message\":\"A Discord user ID has 17 to 20 digits.\"}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"]
        }
      }
    ],
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "subComponents": {},
        "config": {
          "trusted-hosts": ["localhost", "127.0.0.1"],
          "host-sending-registration-request-must-match": ["false"],
          "client-uris-must-match": ["true"]
        }
      },
      {
        "name": "Consent Required",
        "providerId": "consent-required",
        "subType": "anonymous",
        "subComponents": {},
        "config": {}
      },
      {
        "name": "Full Scope Disabled",
        "providerId": "scope",
        "subType": "anonymous",
        "subComponents": {},
        "config": {}
      },
      {
        "name": "Max Clients Limit",
        "providerId": "max-clients",
        "subType": "anonymous",
        "subComponents": {},
        "config": { "max-clients": ["200"] }
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "anonymous",
        "subComponents": {},
        "config": { "allow-default-scopes": ["true"] }
      },
      {
        "name": "Allowed Protocol Mapper Types",
        "providerId": "allowed-protocol-mappers",
        "subType": "anonymous",
        "subComponents": {},
        "config": {
          "allowed-protocol-mapper-types": ["oidc-usermodel-attribute-mapper", "oidc-usermodel-property-mapper", "oidc-full-name-mapper", "oidc-sha256-pairwise-sub-mapper"]
        }
      }
    ]
  },
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "email": "dev@example.invalid",
      "emailVerified": true,
      "firstName": "Dev",
      "realmRoles": ["offline_access"],
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "dev", "temporary": false }
      ]
    }
  ]
}
